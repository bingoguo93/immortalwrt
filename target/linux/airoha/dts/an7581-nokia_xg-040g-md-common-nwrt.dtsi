/dts-v1/;
#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7581.dtsi"

/ {
	aliases {
		pon-calibration = &pon_calibration_storage;
		label-mac-device = &gdm1;

		led-boot = &led_power_green;
		led-failsafe = &led_power_green;
		led-running = &led_power_green;
		led-upgrade = &led_power_green;

		serial0 = &uart1;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/* The reset key is connected to active-low GPIO0. */
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			/* The active-low power LED is connected to GPIO17. */
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

		led-pon {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			/* The active-low PON status LED is connected to GPIO18. */
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
			/* Registration maps O1-O3 to fast blink, O4 to slow blink, and O5 on. */
			linux,default-trigger = "pon0-registration";
		};

		led-los {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			/* The active-low LOS LED is connected to GPIO19. */
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
			/* The pon0-los trigger drives the LOS LED. */
			linux,default-trigger = "pon0-los";
		};

		led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			/* The active-low Internet LED is connected to GPIO20. */
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <2>;
			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port2>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <1>;
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port1>;
		};
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "fixed-3.3V";
	};

	reg_usb_5v: regulator-usb-5v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&en7581_pinctrl 24 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "usb-5v";
	};

	/*
	 * Controls both USB ports at once
	 */
	usb-power {
		compatible = "regulator-output";
		vout-supply = <&reg_usb_5v>;
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	/* Select the PON mux while leaving GPIO38 under optical frontend control. */
	pon_pins: pon-pins {
		mux {
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	pcie2_rst_pins: pcie2-rst-pins {
		conf {
			pins = "pcie_reset2";
			drive-open-drain = <1>;
		};
	};

    gswp1_led0_pins: gswp1-led0-pins {
        mux {
            function = "phy1_led0";
            pins = "gpio33";
        };
    };

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio46";
		};
	};
};

&eth {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&i2c0 {

	status = "okay";

	/* The 0x50 window loads MD32 while the frontend owns runtime window 0x51. */
	en7572: optical-front-end@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;

		/* GPIO38 is the active-high PHY_TX_POWER_DISABLE signal. */
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;

		/* The 512 bytes after the bosa header contain per-device optical data. */
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&npu {
	status = "okay";
};

&mdio {
	/* Airoha EN8811 2.5Gbps phy */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;

		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		/* Hold reset for 1 second and wait 100 ms before probing EN8811H. */
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led-0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&en7572>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	/* data-path references the GDM carrying service GEM traffic. */
	data-path = <&gdm2>;
	status = "okay";
};

&pon_pcs {
	status = "okay";
};

&snfi {
	status = "okay";
};

/*
 * SkyHigh ML02G300WHI00
 */
&spi_nand {
	/*
	 *  ECC must be aligned with bootloader to prevent read errors.
	 *  Stock fw also uses NAND_ECC_NONE.
	 */
	nand-ecc-mode = "none";
	nand-ecc-step-size = <2048>;
	nand-ecc-strength = <0>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&gdm1 {
	status = "okay";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_factory (0)>;
};

&gdm2 {
	/* GDM2 carries the PON GEM data plane on AN7581 and AN7583. */
	airoha,pon-data-path;
	/* WAN uses the eth0 MAC stored at RI offset 0x3e. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_factory (0)>;
	status = "okay";
};

&gdm4 {
	status = "okay";

	phy-handle = <&en8811>;
	phy-mode = "2500base-x";

	openwrt,netdev-name = "lan1";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_factory (1)>;
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
};

&gsw_port2 {
	status = "okay";

	label = "lan2";
};

&gsw_phy2 {
	status = "okay";

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
};

&gsw_phy2_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
};

&gsw_port3 {
	status = "okay";

	label = "lan3";
};

&gsw_phy3 {
	status = "okay";

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
};

&gsw_phy3_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
};

&gsw_port4 {
	status = "okay";

	label = "lan4";
};

&gsw_phy4 {
	status = "okay";

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
};

&gsw_phy4_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	active-low;
};

&usb0 {
	status = "okay";

	vusb33-supply = <&reg_3p3v>;

	#address-cells = <1>;
	#size-cells = <0>;

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&usb1 {
	status = "okay";

	mediatek,u3p-dis-msk = <0x1>;
	phys = <&usb1_phy PHY_TYPE_USB2>;
	vusb33-supply = <&reg_3p3v>;

	#address-cells = <1>;
	#size-cells = <0>;

	usb_port2: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&cpufreq {
	reg = <0x0 0x1fa20000 0x0 0x2c0>,	/* chip-scu */
	      <0x0 0x1efbe000 0x0 0x800>;	/* mcucfg */
	reg-names = "chip-scu", "mcucfg";
};
