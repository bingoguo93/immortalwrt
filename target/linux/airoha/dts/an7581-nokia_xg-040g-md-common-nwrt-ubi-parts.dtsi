/ {
	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
		bootargs-append = " ubi.mtd=rootfs,2048 rootfstype=squashfs ubi.block=0,rootfs ro root=/dev/ubiblock0_3 init=/etc/preinit";
	};
};

&partitions {
       partition@0 {
           label = "bootloader";
           reg = <0x0  0x00080000>;
           read-only;
       };

       partition@80000  {
           label = "env";
           reg = <0x00080000 0x00080000>;
       };

       partition@100000 {
			label = "ubi";
			reg = <0x00100000  0xffe0000>;
			compatible = "linux,ubi";

		volumes {
			ubi-volume-bosa {
				volname = "bosa";
			};

			ubi-volume-factory {
				volname = "ri";

				nvmem-layout {
					compatible = "fixed-layout";

					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_factory_3e: macaddr@3e {
						compatible = "mac-base";
						reg = <0x3e 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			ubi_env: ubi-volume-ubootenv {
				volname = "ubootenv";
			};

			ubi_env2: ubi-volume-ubootenv2 {
				volname = "ubootenv2";
			};
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};
